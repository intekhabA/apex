# ==============================================
# DiagnoLab Multi-Tenant Platform Configuration
# ==============================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="DiagnoLab SaaS"
APP_URL=http://localhost:5173
API_V1_PREFIX=/api

# Security & Cryptography
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production_89abcf12456780e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=diagnolab
MYSQL_PASSWORD=diagnolab_secret
MYSQL_DATABASE=diagnolab_db
DATABASE_URL=mysql+aiomysql://diagnolab:diagnolab_secret@localhost:3306/diagnolab_db
SYNC_DATABASE_URL=mysql+pymysql://diagnolab:diagnolab_secret@localhost:3306/diagnolab_db

# Storage Provider Configuration ('local' or 's3')
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760 # 10 MB

# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=diagnolab-reports

# Super Admin Initial Credentials (Used during initial DB seed)
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=SuperAdmin@2026!
INITIAL_SUPER_ADMIN_NAME="System Administrator"

# CORS Configuration (Comma separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Email & Notifications (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@diagnolab.com
SMTP_FROM_NAME="DiagnoLab Notifications"
